# ============================================================
# AutomateBro — local environment template
# ============================================================
# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit secrets.
#
# See docs/specs/001-project-scaffold.md §3 for setup steps.
# ============================================================

# ---- Application ----
NODE_ENV=development
LOG_LEVEL=info
# Default Next.js dev port. CLAUDE.md port table maps:
#   pnpm dev:website   -> 3000
#   pnpm dev:api       -> 3001
#   pnpm dev:dashboard -> 3002
PORT=3000

# ---- Database (Supabase Postgres via StrictDB) ----
# Source: Supabase Dashboard -> Project Settings -> Database ->
# Connection string -> URI -> Transaction pooler.
# Region MUST be ap-south-1 (Mumbai) for DPDP residency.
STRICTDB_URI=postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres

# ---- Redis (Upstash) ----
# Source: Upstash Dashboard -> Database -> Redis Connect -> redis-cli.
# Wire-protocol URL, NOT the REST URL — BullMQ uses ioredis.
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# ---- Supabase (placeholders for spec 002 — unused in spec 001) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
