# ============================================================
# AutomateBro — local environment template
# ============================================================
# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit secrets.
#
# See docs/specs/001-project-scaffold.md §3 for setup steps.
# ============================================================

# ---- Application ----
NODE_ENV=development
LOG_LEVEL=info
# Default Next.js dev port. CLAUDE.md port table maps:
#   pnpm dev:website   -> 3000
#   pnpm dev:api       -> 3001
#   pnpm dev:dashboard -> 3002
PORT=3000

# ---- Database (Supabase Postgres via StrictDB) ----
# Source: Supabase Dashboard -> Project Settings -> Database ->
# Connection string -> URI -> Transaction pooler.
# Region MUST be ap-south-1 (Mumbai) for DPDP residency.
STRICTDB_URI=postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres

# ---- Redis (Upstash) ----
# Source: Upstash Dashboard -> Database -> Redis Connect -> redis-cli.
# Wire-protocol URL, NOT the REST URL — BullMQ uses ioredis.
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# ---- Supabase (used by spec 002 onwards) ----
# All four come from Supabase Dashboard -> Project Settings -> API.
# NEXT_PUBLIC_* are exposed to the browser bundle. Same values as the
# unprefixed forms — Next.js requires the prefix to expose env to client.
# SUPABASE_SERVICE_ROLE_KEY is server-only — NEVER prefix it NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site URL (optional override) ----
# Used by /logout to compute redirect origin. Defaults to localhost in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
